/FLAGS
# estado del caballero
loco armas_limpias visera nombres armado montado fuerzas ultima_loc
# acompañantes
rocinante_loc sancho_loc sancho_sigue rucio_robado rocinante_cojo
# casa
alacena_abierta arca_abierta tapiada freston sancho_reclutado noche ventana_abierta escala_colgada
lanza_tirada consejo_ventero sancho_casa
# primera salida
montiel_pensado venta_vista ventero_pedido velando arriero1 arriero2 venta_comido
andres_libre andres_aviso encrucijada_vista mercaderes_hablado
# segunda salida
empunada molinos_hechos frailes_hechos vizcaino_pendiente vizcaino_hecho narrador cartapacios_traducidos
oreja_herida cabreros_hechos sal_dada yangueses_hechos llevado_en_rucio
paliza_venta balsamo_hecho balsamo_bendito curado aceite_dado vino_dado pagado manteado
ejercito_hecho muelas encamisados_hechos triste_figura atado batanes_hechos cuento_contado esperas
yelmo_hecho galeotes_hablado galeotes_libres galeotes_apedreado maleta_abierta cardenio_visto
penitencia carta_escrita sancho_fuera versos rosario_rezado princesa_llega princesa_aceptada
cueros_hechos jaula_hecha fin_parte1 escrutinio_hecho
