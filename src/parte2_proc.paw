# =====================================================================
#  SEGUNDA PARTE: tablas de proceso
#  Este fuente se compila ANTES que parte1_proc.paw: sus entradas van
#  delante en cada tabla y pueden adelantarse a las de la Primera Parte.
#  Todas van condicionadas a localidades de la Segunda Parte o al flag
#  parte2, así que no tocan la Primera.
#
#  Subprocesos nuevos: 19 ayuda, 20 Sancho, 21 paso a la Segunda Parte,
#  22/23 guardar y devolver lo que lleva don Quijote mientras juegas
#  como Sancho, 24 Sansón, 25 caballero de los Espejos, 26 leonero,
#  30 la Dolorida, 31 los viejos del báculo
# =====================================================================

/FLAGS
toboso_visto lab_vistas lab_cueva retablo_visto barco_visto insula_vista ronda_vista barcelona_visto

# ---------------------------------------------------------------------
# Paso de la Primera a la Segunda Parte (lo llama la jaula)
/PRO 21
> * _
CLS; MESSAGE segunda_parte; ANYKEY; CLS; MESSAGE visita_cura; ANYKEY; CLS; MESSAGE sancho_noticia; ANYKEY; CLS
> * _
DESTROY alforjas; DESTROY lanza; DESTROY adarga; DESTROY coselete; DESTROY celada; DESTROY espada
DESTROY barras; DESTROY carton; DESTROY llave; DESTROY bolsa; DESTROY camisa; DESTROY sabana
DESTROY escala; DESTROY hierro; DESTROY rama; DESTROY medio_real; DESTROY cartapacios; DESTROY romero
DESTROY sal; DESTROY aceite; DESTROY vino; DESTROY alcuza; DESTROY balsamo; DESTROY bacia
DESTROY librillo; DESTROY tira
> * _
PLACE coselete alcoba2; PLACE bacia alcoba2; PLACE espada alcoba2; PLACE lanza sala2; PLACE adarga sala2
SET parte2; CLEAR montado; CLEAR sancho_sigue; CLEAR llevado_en_rucio; CLEAR empunada; CLEAR rocinante_cojo
LET sancho_loc sala2; LET rocinante_loc corral3; LET fuerzas 60; GOTO alcoba2

# ---------------------------------------------------------------------
/PRO 1
# --- acompañantes (igual que en la Primera Parte, pero antes que las escenas)
> * _
NOTZERO parte2; NOTZERO montado; COPYFF loc rocinante_loc
> * _
NOTZERO parte2; NOTZERO sancho_sigue; COPYFF loc sancho_loc
# --- casa
> * _
AT sala2; ZERO carrasco_hablado; MESSAGE "El bachiller Sansón Carrasco está aquí, con Sancho, esperando a que le hables."
> * _
AT sala2; NOTZERO carrasco_hablado; ZERO tercera; MESSAGE "El bachiller Sansón Carrasco sigue aquí, tan socarrón como siempre."
> * _
AT sala2; NOTZERO carrasco_hablado; ZERO sancho2; MESSAGE "Sancho te mira de reojo. Tiene algo que pedirte y no sabe cómo."
> * _
AT alcoba2; EQ vuelta_vista 2; MESSAGE calentura; LET vuelta_vista 3
> * _
AT alcoba2; NOTZERO cuerdo; MESSAGE "El escribano espera con la pluma mojada. El ama y la sobrina lloran. Sancho también."
# --- El Toboso
> * _
AT toboso; ZERO toboso_visto; SET toboso_visto; MESSAGE toboso_llega
> * _
AT iglesia; ZERO toboso_iglesia; SET toboso_iglesia; MESSAGE iglesia; PLUS score 1
> * _
AT callejuela; ZERO toboso_labrador; MESSAGE labrador_toboso
> * _
AT encinar_toboso; NOTZERO lab_vistas; ZERO encantada; MESSAGE "Las tres labradoras están paradas en el camino, sobre sus pollinos. Sancho, de rodillas, te hace señas."
# --- de camino
> * _
AT camino_carreta; ZERO carreta_hablada; MESSAGE carreta
> * _
AT bosque_espejos; ZERO espejos; MESSAGE espejos_llega
> * _
AT bosque_espejos; NOTZERO espejos; ZERO espejos_hecho; MESSAGE "Aquí hay otro caballero junto a su montura: el de los Espejos."
> * _
AT camino_leones; ZERO leon; ZERO requesones; MESSAGE leones_llega; SET requesones; WORN bacia; MESSAGE requesones
> * _
AT camino_leones; LT leon 2; MESSAGE "El carro de los leones está parado en el camino. El leonero no quita ojo a tu lanza."
> * _
AT camino_leones; EQ leon 2; MESSAGE "Aquí hay un león con cara de hambre."
> * _
AT prado_bodas; ZERO bodas_comido; MESSAGE bodas_prado
> * _
AT enramada; ZERO bodas_trampa; MESSAGE boda; LET bodas_trampa 1
> * _
AT enramada; EQ bodas_trampa 1; MESSAGE "Basilio se desangra en el suelo pidiendo la mano de Quiteria. Camacho no sabe qué hacer, y tú tienes una opinión."
> * _
AT enramada; EQ bodas_trampa 2; MESSAGE "Los amigos de Camacho tienen las espadas desnudas. Basilio y Quiteria se abrazan detrás del cura."
# --- la cueva
> * _
AT boca_cueva; ZERO zarzas; MESSAGE boca_llega
> * _
AT palacio_cristal; ZERO montesinos_hablado; MESSAGE "Montesinos se acerca a ti, despacio, como quien espera desde hace siglos."
> * _
AT palacio_cristal; NOTZERO montesinos_hablado; ZERO lab_cueva; SET lab_cueva; MESSAGE tres_labradoras_cueva
> * _
AT palacio_cristal; NOTZERO lab_cueva; ZERO reales_dados; MESSAGE "La compañera de Dulcinea sigue ahí, con el faldellín en la mano, esperando los reales."
# --- retablo y Ebro
> * _
AT venta_retablo; ZERO retablo_visto; SET retablo_visto; MESSAGE maese_pedro
> * _
AT venta_retablo; EQ retablo 2; MESSAGE "El retablo está hecho una ruina: moros descabezados, Carlomagno sin corona. Maese Pedro llora."
> * _
AT orilla_ebro; ZERO barco_visto; SET barco_visto; MESSAGE barco
> * _
AT orilla_ebro; NOTZERO barco_hecho; MESSAGE "Los restos del barco encantado se alejan río abajo."
> * _
AT orilla_ebro; NOTZERO ebro_atado; MESSAGE "Rocinante y el rucio están atados a un sauce."
# --- los duques
> * _
AT prado_caza; ZERO duquesa_invita; MESSAGE "La gran señora del azor os mira con curiosidad. Parece que sabe quién eres."
> * _
AT castillo_patio; ZERO castillo_visto; SET castillo_visto; MESSAGE castillo_llega; CLEAR montado; LET rocinante_loc castillo_patio; PLUS score 1
> * _
AT castillo_salon; ZERO eclesiastico_hecho; MESSAGE eclesiastico_rine
> * _
AT jardin; NOTZERO eclesiastico_hecho; ZERO dolorida; MESSAGE dolorida; LET dolorida 1
> * _
AT jardin; EQ dolorida 1; MESSAGE "La Dueña Dolorida espera tu respuesta, con sus barbas y las de sus doce dueñas."
> * _
AT jardin; GT dolorida 1; LT dolorida 4; MESSAGE "Clavileño el Alígero espera en mitad del jardín, con su clavija en la frente."
# --- Barataria
> * _
AT barataria; ZERO insula_vista; SET insula_vista; MESSAGE insula_llega
> * _
AT juzgado; ZERO baculo; MESSAGE pleito; LET baculo 1
> * _
AT juzgado; EQ baculo 1; MESSAGE "Los dos viejos esperan tu sentencia. El del báculo, con prisa por irse."
> * _
AT comedor; ZERO gob_comido; MESSAGE "La mesa está llena de platos: fruta, perdices, un salpicón... El doctor Recio no te quita ojo, varilla en mano."
> * _
AT ronda; ZERO gob_comido; MESSAGE "De día no hay ronda que hacer. Las calles están tranquilas y el cronista se aburre."
> * _
AT ronda; NOTZERO gob_comido; ZERO ronda_vista; SET ronda_vista; MESSAGE ronda_llega
> * _
AT ronda; NOTZERO ronda_vista; ZERO ronda_hecha; MESSAGE "La moza vestida de hombre espera, llorando, entre dos corchetes."
# --- la sima, Barcelona y la vuelta
> * _
AT camino_sima; ZERO sima_hecha; MESSAGE voces_sima
> * _
AT ciudad; ZERO barcelona_visto; SET barcelona_visto; MESSAGE barcelona_llega
> * _
AT ciudad; NOTZERO barcelona_visto; ZERO moreno_hecho; MESSAGE "La cabeza encantada de don Antonio está sobre su mesa de jaspe."
> * _
AT playa; ZERO blanca_luna; MESSAGE blanca_luna; LET blanca_luna 1
> * _
AT playa; EQ blanca_luna 1; MESSAGE "El Caballero de la Blanca Luna espera tu respuesta."
> * _
AT playa; EQ blanca_luna 2; MESSAGE "El Caballero de la Blanca Luna ha tomado del campo lo que le parece y te espera, lanza en mano."
> * _
AT aldea2; ZERO vuelta_vista; LET vuelta_vista 1; MESSAGE agueros; PLUS score 1

# ---------------------------------------------------------------------
/PRO 2
# --- en Barataria no hay cansancio que valga (y Sancho anda a pie)
> * _
NOTZERO gob; LET fuerzas 60
# --- el caballero de los Espejos no espera eternamente
> * _
AT bosque_espejos; EQ espejos 2; PLUS espejos_t 1
> * _
AT bosque_espejos; EQ espejos 2; GT espejos_t 5; CLS; MESSAGE espejos_vence; TURNS; END
# --- el león, con hambre
> * _
AT camino_leones; EQ leon 2; PLUS leon_t 1
> * _
AT camino_leones; EQ leon 2; GT leon_t 3; CLS; MESSAGE leon_come; TURNS; END

# ---------------------------------------------------------------------
/PRO 0
# ============================ GENERALES DE LA SEGUNDA PARTE
> DECIR SANCHO
NOTZERO gob; MESSAGE "Hablas solo. Como gobernador, te lo puedes permitir."; DONE
> DECIR SANCHO
NOTZERO parte2; SAME sancho_loc loc; PROCESS 20; DONE
> EX SANCHO
NOTZERO gob; MESSAGE "Eres tú: barriga grande, talle corto, zancas largas. Y ahora, gobernador."; DONE
> LEVEL _
NOTZERO parte2; MESSAGE creditos; MESSAGE creditos2; DONE
> EX REALES
PRESENT reales; MESSAGE "Cuatro reales de plata. No es mucho, pero es todo."; DONE
> EX SOGA
PRESENT soga; MESSAGE "Una soga de cien brazas, regalo de Basilio. Larga como un sermón."; DONE
> EX JOYA
PRESENT joya; MESSAGE "Una joya de oro con una piedra que brilla como un pedazo de sol. Digna de Dulcinea."; DONE
> EX PAÑUELO
PRESENT panuelo; MESSAGE "Un pañuelo de holanda, fino y grande. Valdría para vendar unos ojos."; DONE
> EX BACULO
PRESENT baculo; MESSAGE "Una cañaheja gruesa, más pesada de lo que parece."; DONE
> PONER BACIA
NOTZERO parte2; CARRIED bacia; WEAR bacia; DONE
# en la Segunda Parte la celada ya no está: quien pide la celada quiere el yelmo
> COGER CELADA
NOTZERO parte2; PRESENT bacia; ISNOTAT bacia CARRIED; ISNOTAT bacia WORN; GET bacia; DONE
> PONER CELADA
NOTZERO parte2; CARRIED bacia; WEAR bacia; DONE
> QUITAR CELADA
NOTZERO parte2; WORN bacia; REMOVE bacia; DONE
> EX CELADA
NOTZERO parte2; PRESENT bacia; MESSAGE "El yelmo de Mambrino. Es de oro (o de azófar), le falta media celada y tiene un hueco para la barba. Sancho dice que es una bacía de barbero."; DONE
> VENDAR _
CARRIED panuelo; WEAR panuelo; MESSAGE "Te vendas los ojos con el pañuelo. No ves nada, que es de lo que se trata."; DONE
> VENDAR _
WORN panuelo; MESSAGE "Ya llevas los ojos vendados."; DONE
> VENDAR _
MESSAGE "¿Con qué? Haría falta un pañuelo."; DONE

# ============================ LA CASA
> EX CAMA
AT alcoba2; ZERO reales_hallados; ZERO vuelta_vista; SET reales_hallados; CREATE reales; MESSAGE "Bajo el colchón, donde los escondiste del ama, encuentras cuatro reales. Para una necesidad."; PLUS score 1; DONE
> BUSCAR _
AT alcoba2; ZERO reales_hallados; ZERO vuelta_vista; SET reales_hallados; CREATE reales; MESSAGE "Bajo el colchón, donde los escondiste del ama, encuentras cuatro reales. Para una necesidad."; PLUS score 1; DONE
> EX CAMA
AT alcoba2; MESSAGE "Tu cama. La conoces bien: un mes en ella."; DONE
> EX ARMAS
AT alcoba2; ZERO tercera; MESSAGE "Junto a la cama, colgadas de un clavo, están tus armas. El ama no se ha atrevido a tirarlas: les tiene miedo."; DONE
> DORMIR _
AT alcoba2; ZERO vuelta_vista; MESSAGE "Ya has dormido bastante: un mes entero."; DONE
> DECIR SANSON
AT sala2; ZERO tercera; PROCESS 24; DONE
> DECIR ENCAMISADOS
AT sala2; ZERO tercera; PROCESS 24; DONE
> DECIR _
AT sala2; ZERO tercera; MESSAGE "¿A quién? Aquí están el bachiller SANSON y SANCHO."; DONE
> EX SANSON
AT sala2; ZERO tercera; MESSAGE "Bachiller por Salamanca, de unos veinticuatro años, cariredondo, de nariz chata y de boca grande: señales todas de ser de condición maliciosa y amigo de donaires y de burlas."; DONE
> EX ENCAMISADOS
AT sala2; ZERO tercera; MESSAGE "Bachiller por Salamanca, de unos veinticuatro años, cariredondo, de nariz chata y de boca grande: señales todas de ser de condición maliciosa y amigo de donaires y de burlas."; DONE
> E _
AT corral3; ZERO sancho2; MESSAGE "Sin escudero no sales. Sancho anda por la sala, con algo que pedirte."; DONE
> E _
AT corral3; NOTWORN coselete; MESSAGE "Ponte el coselete. Un caballero no sale en jubón, ni siquiera de noche."; DONE
> E _
AT corral3; NOTWORN bacia; MESSAGE "Ponte el yelmo de Mambrino. Un caballero no sale con la cabeza descubierta."; DONE
> E _
AT corral3; ABSENT lanza; MESSAGE "¿Y la lanza? Está en la sala, en su astillero."; DONE
> E _
AT corral3; ABSENT adarga; ISNOTAT adarga alforjas; MESSAGE "Te falta la adarga."; DONE
> E _
AT corral3; ABSENT espada; ISNOTAT espada alforjas; MESSAGE "Te falta la espada."; DONE
> E _
AT corral3; ZERO montado; MESSAGE "¿A pie? Monta en Rocinante, que ha engordado y tiene ganas."; DONE
> E _
AT corral3; MESSAGE tercera_salida; SET tercera; SET sancho_sigue; PLUS score 2; GOTO camino_toboso; DESC
> O _
AT camino_toboso; MESSAGE "Ya no hay vuelta atrás. Al menos hasta que te venzan."; DONE

# ============================ EL TOBOSO
> DECIR HALDUDO
AT callejuela; ZERO toboso_labrador; MESSAGE labrador_responde; SET toboso_labrador; PLUS score 1; DONE
> DECIR _
AT callejuela; ZERO toboso_labrador; MESSAGE labrador_responde; SET toboso_labrador; PLUS score 1; DONE
> DECIR _
AT callejuela; MESSAGE "El labrador ya se ha ido. Se oye su romance a lo lejos."; DONE
> EX HALDUDO
AT callejuela; ZERO toboso_labrador; MESSAGE "Un mozo de labranza con dos mulas y un arado. Canta muy mal y muy alto."; DONE
> EX IGLESIA
AT iglesia; MESSAGE "Una torre alta y una puerta cerrada. De palacio, nada."; DONE
> ESPERAR _
AT encinar_toboso; NOTZERO sancho_busca; ZERO lab_vistas; MESSAGE tres_labradoras; SET lab_vistas; SET sancho_sigue; LET sancho_loc encinar_toboso; DONE
> ESPERAR _
AT encinar_toboso; ZERO sancho_busca; MESSAGE "¿A quién esperas? Dulcinea no va a venir sola."; DONE
> ARRODILLARSE _
AT encinar_toboso; NOTZERO lab_vistas; ZERO encantada; CLS; MESSAGE encantada; SET encantada; CLEAR montado; COPYFF loc rocinante_loc; PLUS score 4; ANYKEY; DESC
